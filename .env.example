# Required for real route generation and place-name search.
# Create a free openrouteservice account and create a key at https://openrouteservice.org/dev/#/signup
OPENROUTESERVICE_API_KEY=

# Optional MapLibre style URL. Default: CARTO Positron style (attribution shown in app).
NEXT_PUBLIC_MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/positron-gl-style/style.json
